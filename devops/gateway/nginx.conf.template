worker_processes  1;

events {
    worker_connections  1024;
}

http {
    include       "__MIME_TYPES__";
    default_type  application/octet-stream;
    sendfile      on;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    upstream lumix_api {
        server 127.0.0.1:__API_PORT__;
    }

    upstream lumix_web {
        server 127.0.0.1:__WEB_PORT__;
    }

    upstream lumix_admin_web {
        server 127.0.0.1:__ADMIN_WEB_PORT__;
    }

__PUBLIC_HTTP_SERVER__
__PUBLIC_HTTPS_SERVER__

    # 前台與後台使用不同 hostname，維持 cookie、頁面與 API 的 origin 隔離。
    server {
        listen __LOCAL_BIND_ADDRESS__:__HTTPS_PORT__ ssl;
        server_name localhost 127.0.0.1;

        ssl_certificate     "__TLS_CERT__";
        ssl_certificate_key "__TLS_KEY__";
        ssl_protocols       TLSv1.2 TLSv1.3;

        location = /api/admin { return 404; }
        location ^~ /api/admin/ { return 404; }
        location = /admin { return 404; }
        location ^~ /admin/ { return 404; }

        location /api/ {
            proxy_pass http://lumix_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host:$server_port;
            proxy_set_header X-Forwarded-Host $host:$server_port;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }

        location / {
            proxy_pass http://lumix_web;
            proxy_http_version 1.1;
            proxy_set_header Host $host:$server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }

    server {
        listen __LOCAL_BIND_ADDRESS__:__HTTPS_PORT__ ssl;
        server_name admin.localhost;

        ssl_certificate     "__TLS_CERT__";
        ssl_certificate_key "__TLS_KEY__";
        ssl_protocols       TLSv1.2 TLSv1.3;

        # 公開 gateway 啟用後仍只允許同機進入管理端，避免 Host header 繞過 hostname 隔離。
        allow 127.0.0.1;
        allow ::1;
        deny all;

        location = /api { return 404; }
        location = /api/v1 { return 404; }
        location ^~ /api/v1/ { return 404; }

        location /api/admin/ {
            proxy_pass http://lumix_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host:$server_port;
            proxy_set_header X-Forwarded-Host $host:$server_port;
            proxy_set_header X-Forwarded-Port $server_port;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
        }

        location / {
            proxy_pass http://lumix_admin_web;
            proxy_http_version 1.1;
            proxy_set_header Host $host:$server_port;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
        }
    }
}
