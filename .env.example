# 僅供 dev Compose 使用。請複製為 .env，並在部署平台以 secret store 覆蓋所有密碼。
POSTGRES_DB=lumix_dev
POSTGRES_USER=lumix_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# 服務埠集中由此設定；Nginx 只在 loopback 的 HTTPS 埠對外提供本機入口。
LUMIX_API_PORT=8080
LUMIX_API_ADDRESS=127.0.0.1
LUMIX_WEB_PORT=8090
LUMIX_ADMIN_WEB_PORT=8100
LUMIX_HTTPS_PORT=443
# 留白時只提供 localhost；公開時填入 hostname，憑證成功簽發後再填 PEM 路徑。
LUMIX_PUBLIC_HOST=
LUMIX_PUBLIC_TLS_CERT=
LUMIX_PUBLIC_TLS_KEY=

# Docker Compose 僅啟動本機依賴；server、web、admin-web 與 Nginx 都由主機程序啟動。
# 正式環境應只讓 TLS reverse proxy 對外，PostgreSQL、Redis 與 Kafka 不應公開。
LUMIX_POSTGRES_PORT=5432
LUMIX_REDIS_PORT=6379
LUMIX_KAFKA_PORT=9092

# 本機集中日誌（docker compose --profile observability）。所有對外埠只綁 loopback。
ELASTIC_STACK_VERSION=9.5.7
LUMIX_ELASTICSEARCH_PORT=9200
LUMIX_KIBANA_PORT=5601
LUMIX_ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
LUMIX_LOGSTASH_JAVA_OPTS=-Xms256m -Xmx256m
LUMIX_LOG_RETENTION_DAYS=14
LUMIX_ENV=development

# Compose 預設 topology。切換為 READ_WRITE_SPLIT 前，必須先提供已驗證同步的 PostgreSQL replica。
LUMIX_DATABASE_MODE=SINGLE
LUMIX_DATABASE_PRIMARY_MAXIMUM_POOL_SIZE=10
LUMIX_DATABASE_REPLICA_MAXIMUM_POOL_SIZE=10
# 只供本機空資料庫初始化；正式環境必須維持 false。
LUMIX_DATABASE_SEED_ENABLED=false

# 交易命令須同時具備商品 ACTIVE 政策、真實資金與精確 Origin；預設不接新單。
LUMIX_TRADING_SPOT_ENABLED=false
LUMIX_TRADING_FUTURES_ENABLED=false
LUMIX_TRADING_ALLOWED_ORIGIN=
LUMIX_TRADING_ADMIN_ALLOWED_ORIGIN=
LUMIX_FUTURES_LIQUIDATION_POLL_DELAY=PT5S

# Redis 預設單點。cluster 模式需改為 CLUSTER 並由 secret/environment 提供節點清單與密碼。
LUMIX_REDIS_MODE=STANDALONE
LUMIX_REDIS_PASSWORD=
LUMIX_REDIS_CLUSTER_NODES=

# 瀏覽器認證 session。受控 HTTP 開發測試才可為 false；正式 TLS ingress 必須為 true。
LUMIX_AUTH_COOKIE_SECURE=false
LUMIX_AUTH_COOKIE_NAME=LUMIX_SESSION
LUMIX_AUTH_ADMIN_COOKIE_NAME=LUMIX_ADMIN_SESSION
LUMIX_AUTH_SESSION_TTL=PT8H
LUMIX_AUTH_BCRYPT_STRENGTH=12

# 最高管理員只可由這個信箱透過一次性啟用連結自行設定密碼；設定後不得任意更換。
# 填入時必須同時啟用下方受控 SMTP，否則 server 會 fail-closed 拒絕啟動。
LUMIX_ADMIN_SUPER_ADMIN_EMAIL=
# 最高管理員首次啟用信語系；留白預設 en-US，目前支援 en-US、zh-TW。
LUMIX_ADMIN_SUPER_ADMIN_LOCALE=en-US

# 未提供受控 SMTP 時，忘記密碼 endpoint 會 fail-closed，不會把 reset token 寫到 API 或 log。
LUMIX_AUTH_PASSWORD_RESET_SMTP_ENABLED=false
LUMIX_AUTH_PASSWORD_RESET_TTL=PT30M
# 僅允許 http://localhost、http://127.0.0.1 或 http://[::1] 的同機開發測試；公開環境維持 false。
LUMIX_AUTH_PASSWORD_RESET_ALLOW_LOOPBACK_HTTP=false
LUMIX_AUTH_PASSWORD_RESET_FROM_ADDRESS=
LUMIX_AUTH_PUBLIC_BASE_URL=
# 管理端重設連結必須走獨立 admin-web origin，不能導回前台 web service。
LUMIX_AUTH_ADMIN_PUBLIC_BASE_URL=
# 註冊 email 同時要求六位數字碼與五位英文字母碼；SMTP 未啟用時註冊會 fail-closed。
LUMIX_AUTH_REGISTRATION_VERIFICATION_TTL=PT10M
LUMIX_AUTH_REGISTRATION_VERIFICATION_MAX_ATTEMPTS=5
LUMIX_AUTH_REGISTRATION_VERIFICATION_LETTER_OPTION_COUNT=4

# 正式 TLS ingress 必須設為 true；Compose 本機 HTTP 驗證維持 false。
LUMIX_SECURITY_REQUIRE_HTTPS=false

# Ethereum Mainnet 唯讀觀測。RPC URL 必須由 secret manager 注入；禁止提交 API key、助記詞或 private key。
LUMIX_ETHEREUM_OBSERVATION_ENABLED=false
LUMIX_ETHEREUM_RPC_URL=
LUMIX_ETHEREUM_CHAIN_ID=1
LUMIX_ETHEREUM_CONNECT_TIMEOUT=PT5S
LUMIX_ETHEREUM_READ_TIMEOUT=PT15S

# 僅在啟用 password reset SMTP 後填入；實際帳密必須由部署平台 secret store 注入。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
