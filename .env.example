# 僅供 dev Compose 使用。請複製為 .env，並在部署平台以 secret store 覆蓋所有密碼。
POSTGRES_DB=lumix_dev
POSTGRES_USER=lumix_app
POSTGRES_PASSWORD=replace-with-a-long-unique-password

# 對主機開放的測試埠；正式環境應只讓 TLS reverse proxy 對外，PostgreSQL 與 Redis 不應公開。
LUMIX_WEB_PORT=8088
LUMIX_SERVER_PORT=8080
LUMIX_POSTGRES_PORT=5432
LUMIX_REDIS_PORT=6379

# Compose 預設 topology。切換為 READ_WRITE_SPLIT 前，必須先提供已驗證同步的 PostgreSQL replica。
LUMIX_DATABASE_MODE=SINGLE
LUMIX_DATABASE_PRIMARY_MAXIMUM_POOL_SIZE=10
LUMIX_DATABASE_REPLICA_MAXIMUM_POOL_SIZE=10

# Redis 預設單點。cluster 模式需改為 CLUSTER 並由 secret/environment 提供節點清單與密碼。
LUMIX_REDIS_MODE=STANDALONE
LUMIX_REDIS_PASSWORD=
LUMIX_REDIS_CLUSTER_NODES=

# 瀏覽器認證 session。受控 HTTP 開發測試才可為 false；正式 TLS ingress 必須為 true。
LUMIX_AUTH_COOKIE_SECURE=false
LUMIX_AUTH_COOKIE_NAME=LUMIX_SESSION
LUMIX_AUTH_SESSION_TTL=PT8H
LUMIX_AUTH_BCRYPT_STRENGTH=12

# 未提供受控 SMTP 時，忘記密碼 endpoint 會 fail-closed，不會把 reset token 寫到 API 或 log。
LUMIX_AUTH_PASSWORD_RESET_SMTP_ENABLED=false
LUMIX_AUTH_PASSWORD_RESET_TTL=PT30M
# 僅允許 http://localhost、http://127.0.0.1 或 http://[::1] 的同機開發測試；公開環境維持 false。
LUMIX_AUTH_PASSWORD_RESET_ALLOW_LOOPBACK_HTTP=false
LUMIX_AUTH_PASSWORD_RESET_FROM_ADDRESS=
LUMIX_AUTH_PUBLIC_BASE_URL=
# 註冊 email 同時要求六位數字碼與五位英文字母碼；SMTP 未啟用時註冊會 fail-closed。
LUMIX_AUTH_REGISTRATION_VERIFICATION_TTL=PT10M
LUMIX_AUTH_REGISTRATION_VERIFICATION_MAX_ATTEMPTS=5

# 正式 TLS ingress 必須設為 true；Compose 本機 HTTP 驗證維持 false。
LUMIX_SECURITY_REQUIRE_HTTPS=false

# 僅在啟用 password reset SMTP 後填入；實際帳密必須由部署平台 secret store 注入。
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
