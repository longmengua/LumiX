# 預備／壓測環境範本。以獨立 project 啟動，禁止使用 production 資料或 credential。
POSTGRES_DB=lumix_pre
POSTGRES_USER=lumix_app
POSTGRES_PASSWORD=replace-with-a-different-pre-password
LUMIX_WEB_PORT=8188
LUMIX_ADMIN_WEB_PORT=8189
LUMIX_SERVER_PORT=8180
LUMIX_POSTGRES_PORT=5542
LUMIX_REDIS_PORT=6479
LUMIX_DATABASE_MODE=SINGLE
LUMIX_DATABASE_PRIMARY_MAXIMUM_POOL_SIZE=20
LUMIX_DATABASE_REPLICA_MAXIMUM_POOL_SIZE=10
LUMIX_REDIS_MODE=STANDALONE
LUMIX_REDIS_PASSWORD=
LUMIX_REDIS_CLUSTER_NODES=
LUMIX_AUTH_COOKIE_SECURE=false
LUMIX_AUTH_COOKIE_NAME=LUMIX_PRE_SESSION
LUMIX_AUTH_ADMIN_COOKIE_NAME=LUMIX_PRE_ADMIN_SESSION
LUMIX_AUTH_SESSION_TTL=PT8H
LUMIX_AUTH_BCRYPT_STRENGTH=12
LUMIX_AUTH_PASSWORD_RESET_SMTP_ENABLED=false
LUMIX_AUTH_PASSWORD_RESET_TTL=PT30M
LUMIX_AUTH_PASSWORD_RESET_ALLOW_LOOPBACK_HTTP=false
LUMIX_AUTH_PASSWORD_RESET_FROM_ADDRESS=
LUMIX_AUTH_PUBLIC_BASE_URL=
LUMIX_AUTH_ADMIN_PUBLIC_BASE_URL=
LUMIX_AUTH_REGISTRATION_VERIFICATION_TTL=PT10M
LUMIX_AUTH_REGISTRATION_VERIFICATION_MAX_ATTEMPTS=5
LUMIX_AUTH_REGISTRATION_VERIFICATION_LETTER_OPTION_COUNT=4
LUMIX_SECURITY_REQUIRE_HTTPS=false
